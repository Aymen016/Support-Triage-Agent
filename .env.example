# Copy this to .env and fill in real values. Never commit .env.

# Required for real classification/extraction/drafting (Phase 2+3).
# Without this, use agent.llm_client.FakeLLMClient for offline dev/tests.
ANTHROPIC_API_KEY=

# Phase 6 — only needed once you move off fixtures onto real Gmail.
# Create an OAuth 2.0 "Desktop app" Client ID in Google Cloud Console, with
# the Gmail API and Sheets API both enabled on that project. One consent
# grant (see integrations/google_auth.py) covers Gmail + Sheets — there is
# no separate Sheets credential.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_LABEL_TO_POLL=support

# Phase 6 — only needed once you move off local CSV onto real Sheets.
# Reuses the Gmail OAuth credentials above. Just the target spreadsheet's ID
# (from its URL: /spreadsheets/d/<THIS_PART>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Dev database (Phase 3/4). Swap for a Postgres URL later.
DATABASE_URL=sqlite:///./data/triage.db
